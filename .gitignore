# Build artifacts and large data — never commit (far over GitHub limits).
/data/
/weights/
*.faiss
*.f16.dat
*.f16.npy
*.parquet
*.tar
*.meta.json
*.arrays.cache
shards/
# Default download cache visualize_results creates when no data_root is
# given (viz.py: cache_dir or data_root or "themis-cdf-cache"). Holds
# full-size CDFs, so it reaches gigabytes without anyone deciding to.
/themis-cdf-cache/

# Working material, not part of the release: the v0.2 runbook and any local
# LaTeX compile scratch. Ignored rather than merely excluded from `git add`,
# so a stray `git add -A` cannot pick them up.
/v2-plan.md
scripts/table-test.tex
scripts/table-final.tex

# Editor swap/backup files. A .swp for an open file is easy to sweep up with
# `git add -A` and pointless to version.
*.swp
*.swo
*~
.*.sw[a-p]
*.aux
*.out
*.synctex.gz

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.coverage
htmlcov/
.ipynb_checkpoints/


# Sphinx docs build
docs/_build/
docs/generated/

# Claude Code local config
.claude/
